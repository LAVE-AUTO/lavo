            "description": "GET /api/v1/stations/:id/formats — public. Returns list of vehicle formats (id, station_id, label, price, is_active, created_at, updated_at). 404 if station not found or not active."
          },
          "response": []
        },
        {
          "name": "Create format (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body has format', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('id');",
                  "  pm.expect(json.data).to.have.property('label');",
                  "  pm.expect(json.data).to.have.property('price');",
                  "});"
