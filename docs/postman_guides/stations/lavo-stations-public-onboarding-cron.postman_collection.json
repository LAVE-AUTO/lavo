    }
  ],
  "item": [
    {
      "name": "Public — Stations",
      "item": [
        {
          "name": "List stations (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has data.all and meta', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('data');",
                  "  pm.expect(json.data).to.have.property('all');",
                  "  pm.expect(Array.isArray(json.data.all)).to.be.true;",
                  "  pm.expect(json).to.have.property('meta');",
                  "  pm.expect(json.meta).to.have.property('total');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations?q=paris&page=1&per_page=20&sort=name_asc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations"
              ],
              "query": [
                { "key": "q", "value": "paris" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" },
                { "key": "sort", "value": "name_asc" }
              ]
            },
            "description": "GET /api/v1/stations — list active stations. Response: data.all (array), data.available_now? etc. if groups=..., meta (total, page, per_page, total_pages). Query: q, city, sort, page, per_page, limit_per_group, wash_type_ids, service_scope, format_id."
          },
          "response": []
        },
        {
          "name": "List stations with groups (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has groups when requested', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('all');",
                  "  pm.expect(json.data).to.have.property('available_now');",
                  "  pm.expect(json.data).to.have.property('most_appreciated');",
                  "  pm.expect(json.data).to.have.property('most_visited');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations?groups=available_now,most_appreciated,most_visited&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stations"],
              "query": [
                { "key": "groups", "value": "available_now,most_appreciated,most_visited" },
                { "key": "per_page", "value": "10" }
              ]
            },
            "description": "GET /api/v1/stations with groups — returns data.all plus data.available_now, data.most_appreciated, data.most_visited."
          },
          "response": []
        },
        {
          "name": "List stations — invalid sort (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('VALIDATION_FAILED', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.code).to.eql('VALIDATION_FAILED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations?sort=invalid_sort",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "invalid_sort"
                }
              ]
            },
            "description": "Negative test: invalid sort must return 400 VALIDATION_FAILED."
          },
          "response": []
        },
        {
          "name": "Station detail (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has station id', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('id');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations/{{station_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations",
                "{{station_id}}"
              ]
            },
            "description": "GET /api/v1/stations/:id — station detail. Requires station_id. Response includes available, available_slots, completed_count (services terminés)."
          },
          "response": []
        },
        {
          "name": "Join station (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('mapsUrl present', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('mapsUrl');",
                  "  pm.expect(json.data.mapsUrl).to.match(/^https:\\/\\/www\\.google\\.com\\/maps\\?q=/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations/{{station_id}}/join",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations",
                "{{station_id}}",
                "join"
              ]
            },
            "description": "POST /api/v1/stations/:id/join — returns a Google Maps URL."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Onboarding",
      "item": [
        {
          "name": "Upload document (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body has url and storage', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('url');",
                  "  pm.expect(json.data).to.have.property('storage');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stations/onboarding/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations",
                "onboarding",
                "upload"
              ]
            },
            "description": "POST /api/v1/stations/onboarding/upload — multipart/form-data, field 'file'. No auth. Returns 201 with { data: { url, storage } }. Use url (and storage) in onboarding submit documents."
          },
          "response": []
        },
        {
          "name": "Submit onboarding (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body has user and station', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('user');",
                  "  pm.expect(json.data).to.have.property('station');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"station@example.com\",\n  \"phone\": \"+33600000000\",\n  \"password\": \"Password1!\",\n  \"confirm_password\": \"Password1!\",\n  \"station_name\": \"Test Station\",\n  \"address\": \"1 rue Test\",\n  \"city\": \"Paris\",\n  \"wash_post_count\": 2,\n  \"wash_type_ids\": [\"<uuid from wash_types table>\"],\n  \"service_scope\": \"both\",\n  \"documents\": [\n    { \"document_type\": \"kbis\", \"file_url\": \"https://example.com/doc.pdf\", \"storage\": \"cloudinary\" }\n  ],\n  \"terms_accepted\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stations/onboarding/submit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations",
                "onboarding",
                "submit"
              ]
            },
            "description": "POST /api/v1/stations/onboarding/submit — step 2 uses wash_type_ids (array of UUIDs from wash_types), optional service_scope (exterior|interior|both). Replace wash_type_ids with real UUIDs from DB. No auth."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Formats (vehicle formats and pricing)",
