                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations/{{station_id}}/formats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations",
                "{{station_id}}",
                "formats"
              ]
            },
            "description": "GET /api/v1/stations/:id/formats — public. Retourne la liste des formats de vehicule (id, station_id, label, price, is_active). 404 si la station n'existe pas ou n'est pas active."
          },
          "response": []
        },
        {
          "name": "Create format (201)",
          "event": [
