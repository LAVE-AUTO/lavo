    {
      "name": "Client — Queue & entries",
      "item": [
        {
          "name": "Join queue (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"vehicle_format_id\": \"{{format_id}}\"}" },
            "url": { "raw": "{{base_url}}/api/v1/stations/{{station_id}}/queue/join", "host": ["{{base_url}}"], "path": ["api", "v1", "stations", "{{station_id}}", "queue", "join"] }
          },
          "response": [],
          "description": "POST /api/v1/stations/:id/queue/join — auth client. Body: vehicle_format_id. Creates queue entry."
        },
        {
          "name": "Get queue (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/stations/{{station_id}}/queue", "host": ["{{base_url}}"], "path": ["api", "v1", "stations", "{{station_id}}", "queue"] }
          },
          "response": [],
          "description": "GET /api/v1/stations/:id/queue — list queue entries (public or auth)."
        },
        {
          "name": "My entries (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/me/entries", "host": ["{{base_url}}"], "path": ["api", "v1", "me", "entries"] }
          },
          "response": [],
