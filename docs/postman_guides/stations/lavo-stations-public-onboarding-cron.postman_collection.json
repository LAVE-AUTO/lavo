          },
          "response": [],
          "description": "PATCH /api/v1/me/entries/:entryId/cancel — auth client."
        },
        {
          "name": "Upgrade to reservation (200)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
