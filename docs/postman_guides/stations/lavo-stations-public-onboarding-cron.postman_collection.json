{
  "info": {
    "_postman_id": "2ef04412-e41a-4ece-97a7-12091ab0dd12",
    "name": "LAVO — Stations (Public + Onboarding + Cron)",
    "description": "Collection:\n- Public: stations API (list with groups/pagination/filters, detail with completed_count, join)\n- Client: queue/join, me/entries, cancel, upgrade-to-reservation; create reservation\n- Station: entries list, PATCH entry status/position; reservations list by station\n- Onboarding: upload and submit (wash_type_ids array, optional service_scope)\n- Formats: vehicle formats CRUD\n- Cron: sync pending uploads, downgrade-late-reservations\n\nRequired: base_url. Optional: station_id, format_id, entry_id, time_slot_id, access_token (client or station), cron_secret.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
