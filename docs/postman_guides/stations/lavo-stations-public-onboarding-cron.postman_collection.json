          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"vehicle_format_id\": \"{{format_id}}\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stations/{{station_id}}/queue/join",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations",
                "{{station_id}}",
                "queue",
                "join"
              ]
