    {
      "name": "Station — Entries",
      "description": "Repositionnement en file uniquement. Pour lister les entrees et mettre a jour le statut, voir lavo-reservations.",
      "item": [
        {
          "name": "PATCH entry position (200)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"queue_position\": 1}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/station/entries/{{entry_id}}/position",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "station",
                "entries",
                "{{entry_id}}",
                "position"
              ]
            },
            "description": "PATCH /api/v1/station/entries/:id/position — auth STATION. Repositionne une entree dans la file. Body: queue_position (entrees queue uniquement)."
          },
          "response": []
        },
        {
          "name": "Pick client file d'attente (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Entry status = in_progress', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.entry.status).to.eql('in_progress');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations/queue/{{queue_entry_id}}/pick",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations",
                "queue",
                "{{queue_entry_id}}",
                "pick"
              ]
            },
            "description": "POST /api/v1/stations/queue/:queueId/pick — Auth STATION. Selectionne un client walk-in de la file pour le servir immediatement. Passe le statut a in_progress et compacte les positions restantes."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cron — Sync / Downgrade / Rappels",
      "item": [
        {
          "name": "Sync pending uploads (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has processed/succeeded/failed', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('processed');",
                  "  pm.expect(json.data).to.have.property('succeeded');",
