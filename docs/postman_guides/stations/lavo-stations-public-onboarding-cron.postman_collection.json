              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cron/downgrade-late-reservations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cron",
                "downgrade-late-reservations"
              ]
