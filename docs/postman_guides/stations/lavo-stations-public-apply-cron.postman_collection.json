    {
      "name": "Cron — Pending uploads sync (Card 2)",
      "item": [
        {
          "name": "Sync pending uploads (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has processed/succeeded/failed', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('processed');",
                  "  pm.expect(json.data).to.have.property('succeeded');",
                  "  pm.expect(json.data).to.have.property('failed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-cron-secret",
                "value": "{{cron_secret}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cron/sync-pending-uploads",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cron",
                "sync-pending-uploads"
              ]
            },
            "description": "GET /api/cron/sync-pending-uploads — requires x-cron-secret (or Authorization: Bearer <CRON_SECRET>)."
          },
          "response": []
        },
