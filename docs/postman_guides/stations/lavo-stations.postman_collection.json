    {
      "name": "Station — Historique",
      "description": "GET /api/v1/history/station — historique d'activite pagine de la station authentifiee. Combine reservations et donnees financieres (commission, pourboire, payout). Auth: role station + station active.",
      "item": [
        {
          "name": "Historique station — succes sans filtres (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has items and meta', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('items').that.is.an('array');",
                  "  pm.expect(json.data).to.have.property('meta');",
                  "  pm.expect(json.data.meta).to.have.all.keys('total', 'page', 'limit', 'total_pages');",
                  "  pm.expect(json.data.meta.page).to.eql(1);",
                  "  pm.expect(json.data.meta.limit).to.eql(20);",
                  "});",
                  "pm.test('Items have expected shape', () => {",
                  "  const json = pm.response.json();",
                  "  if (json.data.items.length > 0) {",
                  "    const item = json.data.items[0];",
                  "    pm.expect(item).to.have.property('id');",
                  "    pm.expect(item).to.have.property('date');",
                  "    pm.expect(item).to.have.property('status');",
                  "    pm.expect(item).to.have.property('amount_paid');",
                  "    pm.expect(item).to.have.property('reservation_ref');",
                  "    pm.expect(item).to.not.have.property('password_hash');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/history/station",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "history", "station"]
            },
            "description": "Retourne la premiere page (20 elements) de l'historique complet. Auth: cookie JWT station active."
          }
        },
