        {
          "name": "submit — succes (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Retourne user + station', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('user');",
                  "  pm.expect(json.data).to.have.property('station');",
                  "  pm.expect(json.data.user).to.not.have.property('password_hash');",
                  "  pm.expect(json.data.user.role).to.eql('station');",
                  "  pm.expect(json.data.station.status).to.eql('pending_admin_validation');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/stations/onboarding/submit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations",
                "onboarding",
                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"station@example.com\",\n  \"phone\": \"+33612345678\",\n  \"password\": \"StationPass1!\",\n  \"confirm_password\": \"StationPass1!\",\n  \"station_name\": \"Lavo Station Paris 15\",\n  \"legal_name\": \"Lavo SAS\",\n  \"registration_number\": \"RCS PARIS 123456789\",\n  \"address\": \"12 rue de la Paix\",\n  \"city\": \"Paris\",\n  \"latitude\": 48.8566,\n  \"longitude\": 2.3522,\n  \"wash_post_count\": 4,\n  \"wash_type\": \"automatic\",\n  \"description\": \"Station de lavage automatique au coeur de Paris.\",\n  \"documents\": [\n    {\"document_type\": \"registre_commerce\", \"file_url\": \"https://storage.example.com/doc1.pdf\"},\n    {\"document_type\": \"piece_identite\", \"file_url\": \"https://storage.example.com/doc2.pdf\"}\n  ],\n  \"terms_accepted\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cree le compte, la station et les documents en une seule transaction. Email de verification envoye. Aucune ecriture en base avant cet appel."
          }
        },
