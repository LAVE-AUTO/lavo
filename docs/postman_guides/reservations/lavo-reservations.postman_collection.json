{
  "info": {
    "name": "LAVO — Reservations API",
    "description": "Collection pour le systeme de reservation incluant la creation, la consultation (user/station), l'annulation, la confirmation de presence, et le webhook Stripe.\n\nVariables requises : `base_url`, `access_token`, `station_id`, `time_slot_id`, `vehicle_format_id`\nVariables auto-remplies : `reservation_id`, `stripe_client_secret`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Creation de reservation",
      "description": "POST /api/v1/stations/:station_id/reservations — Cree une reservation avec paiement Stripe Connect.\n\nPrerequis : utilisateur authentifie (role client), station active avec stripe_account_id, creneau disponible.",
      "item": [
        {
          "name": "Creer reservation — succes (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Retourne reservation_id et stripe_client_secret', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('reservation_id');",
                  "  pm.expect(json.data).to.have.property('stripe_client_secret');",
                  "  pm.expect(json.data.status).to.eql('pending_payment');",
                  "  pm.environment.set('reservation_id', json.data.reservation_id);",
                  "  pm.environment.set('stripe_client_secret', json.data.stripe_client_secret);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/stations/{{station_id}}/reservations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations",
                "{{station_id}}",
                "reservations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"time_slot_id\": \"{{time_slot_id}}\",\n  \"vehicle_format_id\": \"{{vehicle_format_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cree une reservation pour le creneau et le format de vehicule indiques. Retourne un stripe_client_secret pour finaliser le paiement cote frontend."
          }
        },
