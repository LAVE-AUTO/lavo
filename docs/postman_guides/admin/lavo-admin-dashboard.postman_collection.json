                  "  pm.expect(period).to.have.property('to');",
                  "  pm.expect(period).to.have.property('days');",
                  "});",
                  "pm.test('Retourne la structure dashboard complete', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('totals');",
                  "  pm.expect(json.data).to.have.property('metrics');",
                  "  pm.expect(json.data).to.have.property('alerts');",
                  "});"
