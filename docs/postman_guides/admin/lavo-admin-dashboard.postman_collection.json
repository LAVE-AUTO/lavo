    {
      "name": "Admin - Analytics",
      "description": "GET /api/v1/admin/analytics/[metric] - Retourne une serie temporelle pour la metrique demandee.\n\nMetriques valides : transactions, revenue, commissions, registrations, stations, reservations, cancellations, support-tickets, avg-rating\n\nQuery params :\n- ?from=YYYY-MM-DD&to=YYYY-MM-DD (les deux requis si l'un est fourni)\n- ?group_by=day|week|month (defaut: day)\n- Aucun param → fenetre 30 jours par defaut\n\nReponse 200 : { data: { metric, group_by, period: { from, to }, series: [{ date, value }] } }\n\nCache-Control: max-age=60, s-maxage=60",
      "item": [
        {
          "name": "Analytics - transactions/day (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retourne serie transactions par jour', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.series).to.be.an('array');",
                  "  pm.expect(json.data.metric).to.eql('transactions');",
                  "  pm.expect(json.data).to.have.property('group_by');",
                  "  pm.expect(json.data.group_by).to.eql('day');",
                  "  pm.expect(json.data).to.have.property('period');",
                  "  pm.expect(json.data.period).to.have.property('from');",
                  "  pm.expect(json.data.period).to.have.property('to');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/analytics/transactions?from=2026-01-01&to=2026-03-26&group_by=day",
