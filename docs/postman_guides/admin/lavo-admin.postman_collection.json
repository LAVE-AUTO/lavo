{
  "info": {
    "name": "LAVO — Admin API",
    "description": "Collection pour les endpoints d'administration LAVO.\n\nVariable requise : `base_url` (ex: http://localhost:3000)\nVariable requise : `access_token` (JWT admin, obtenu après login admin)\nVariable requise : `station_id` (UUID de la station ciblée)\n\n## Groupes\n- **Admin — Stations** : lister, détailler, approuver, rejeter les demandes d'inscription station",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "station_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Admin — Stations",
      "item": [
        {
          "name": "Lister stations en attente (200)",
          "response": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/stations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "stations"
              ]
            },
            "description": "Authentifie admin. Retourne les stations avec status=pending_admin_validation."
          }
        },
        {
          "name": "Detail station (200)",
          "response": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/stations/{{station_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "stations",
                "{{station_id}}"
              ]
            },
            "description": "Detail station incluant les documents soumis."
          }
        },
        {
          "name": "Approuver station (200)",
          "response": [],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/stations/{{station_id}}/approve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "stations",
                "{{station_id}}",
                "approve"
              ]
            },
            "description": "Approuve la station — status=active."
          }
        },
        {
          "name": "Rejeter station (200)",
          "response": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/stations/{{station_id}}/reject",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "stations",
                "{{station_id}}",
                "reject"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"rejection_reason\":\"Documents fournis incomplets ou invalides.\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Rejette la station — status=rejected avec raison."
          }
        },
        {
          "name": "Rejeter — raison trop courte (400)",
          "response": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/stations/{{station_id}}/reject",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "stations",
                "{{station_id}}",
                "reject"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"rejection_reason\":\"Non\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "400 VALIDATION_FAILED — rejection_reason trop courte."
          }
        },
        {
          "name": "Admin — non autorise (403)",
          "response": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/stations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "stations"
              ]
            },
            "description": "403 FORBIDDEN — role != admin."
          }
        }
      ]
    }
  ]
}