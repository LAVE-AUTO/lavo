{
  "info": {
    "name": "LAVO — Auth API",
    "description": "Collection de tests pour le module d'authentification LAVO.\n\nVariable d'environnement requise : `base_url` (ex: http://localhost:3000)\n\n## Flux de test recommandé\n1. Register → récupère access_token (15 min) + refresh_token (1j/30j)\n2. Me → vérifie la session via access_token\n3. Refresh → rotation du refresh_token, nouveaux cookies\n4. Logout → révocation DB + suppression cookies",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Register",
      "item": [
        {
          "name": "Register — succès",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body contient data.id', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('id');",
                  "  pm.expect(json.data).to.not.have.property('password_hash');",
                  "  pm.expect(json.data.status).to.eql('pending_verification');",
                  "  pm.expect(json.data.role).to.eql('client');",
                  "});",
                  "pm.test('Cookie access_token présent (15 min)', () => {",
                  "  pm.expect(pm.cookies.has('access_token')).to.be.true;",
                  "});",
                  "pm.test('Cookie refresh_token présent', () => {",
                  "  pm.expect(pm.cookies.has('refresh_token')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jean\",\n  \"last_name\": \"Dupont\",\n  \"email\": \"jean.dupont@example.com\",\n  \"phone\": \"0612345678\",\n  \"password\": \"Test@1234\",\n  \"remember_me\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Register — remember_me 30 jours",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Cookie access_token présent', () => {",
                  "  pm.expect(pm.cookies.has('access_token')).to.be.true;",
                  "});",
                  "pm.test('Cookie refresh_token présent (30j)', () => {",
                  "  pm.expect(pm.cookies.has('refresh_token')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Marie\",\n  \"last_name\": \"Martin\",\n  \"email\": \"marie.martin@example.com\",\n  \"phone\": \"0698765432\",\n  \"password\": \"Test@1234\",\n  \"remember_me\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Register — email déjà utilisé (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Code EMAIL_ALREADY_EXISTS', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.code).to.eql('EMAIL_ALREADY_EXISTS');",
                  "  pm.expect(json).to.not.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jean\",\n  \"last_name\": \"Dupont\",\n  \"email\": \"jean.dupont@example.com\",\n  \"phone\": \"0612345678\",\n  \"password\": \"Test@1234\",\n  \"remember_me\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Register — validation échouée (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Code VALIDATION_FAILED avec errors[]', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.code).to.eql('VALIDATION_FAILED');",
                  "  pm.expect(json.errors).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(json).to.not.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"\",\n  \"last_name\": \"D\",\n  \"email\": \"pas-un-email\",\n  \"phone\": \"06\",\n  \"password\": \"faible\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Register — mot de passe sans majuscule (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Erreur sur le champ password', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.errors.some(e => e.field === 'password')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jean\",\n  \"last_name\": \"Dupont\",\n  \"email\": \"nouveau@example.com\",\n  \"phone\": \"0612345678\",\n  \"password\": \"test@1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Register — body JSON invalide (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "not valid json {"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Session",
      "item": [
        {
          "name": "Me — authentifié (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retourne SafeUser sans password_hash', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('id');",
                  "  pm.expect(json.data).to.have.property('email');",
                  "  pm.expect(json.data).to.not.have.property('password_hash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Le cookie access_token (15 min) est envoyé automatiquement. Doit être appelé après un register ou refresh réussi."
          }
        },
        {
          "name": "Me — non authentifié (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Code UNAUTHORIZED', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.code).to.eql('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "",
                "description": "Cookie vide pour simuler une session absente"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Refresh Token",
      "item": [
        {
          "name": "Refresh — rotation réussie (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('refreshed = true', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.refreshed).to.be.true;",
                  "});",
                  "pm.test('Nouveau cookie access_token', () => {",
                  "  pm.expect(pm.cookies.has('access_token')).to.be.true;",
                  "});",
                  "pm.test('Nouveau cookie refresh_token', () => {",
                  "  pm.expect(pm.cookies.has('refresh_token')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Le cookie refresh_token est envoyé automatiquement. L'ancien refresh_token est révoqué en DB et deux nouveaux cookies sont émis."
          }
        },
        {
          "name": "Refresh — sans cookie (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Code UNAUTHORIZED', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.code).to.eql('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "",
                "description": "Cookie vide pour simuler l'absence de refresh_token"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Refresh — token révoqué (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Code UNAUTHORIZED', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.code).to.eql('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "refresh_token=ancien_token_deja_utilise",
                "description": "Simuler un replay attack avec un token déjà révoqué"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        }
      ]
    },
