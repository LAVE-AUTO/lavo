    {
      "name": "Logout",
      "item": [
        {
          "name": "Logout (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('logged_out true', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.logged_out).to.be.true;",
                  "});",
                  "pm.test('Cookie access_token supprimé', () => {",
                  "  pm.expect(pm.cookies.has('access_token')).to.be.false;",
                  "});",
                  "pm.test('Cookie refresh_token supprimé', () => {",
                  "  pm.expect(pm.cookies.has('refresh_token')).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Révoque le refresh_token en DB et supprime les deux cookies."
          }
        }
      ]
    },
