# Copy to .env and fill in; do not commit .env.

# Database (Neon in dev; Railway PostgreSQL in production)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Seed script: optional bcrypt hash for seed admin (default hash is for password "ChangeMe123!")
# SEED_ADMIN_PASSWORD_HASH=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api/v1"
NODE_ENV="development"

# i18n (next-intl)
# Default locale: fr. Supported: fr, en. URLs: /fr, /en

# Auth (future)
JWT_SECRET="your-jwt-secret-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# OAuth (future)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Stripe (future)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# Station apply uploads and admin notification; fill these to enable apply + sync job.
# Admin notification: recipient for new station application alerts (Resend)
ADMIN_NOTIFICATION_EMAIL=""

# Weekly escrow report: recipient for /api/cron/send-escrow-weekly-transactions-report.
# If unset, falls back to ADMIN_NOTIFICATION_EMAIL.
WEEKLY_TRANSACTIONS_REPORT_EMAIL=""
# Weekly escrow report email locale: "fr" or "en" (default fr).
WEEKLY_REPORT_LOCALE="fr"

# Station document uploads: Cloudinary (primary); unset = fallback to local disk
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Local fallback path for document uploads when Cloudinary fails or is unset.
# In production, point this to a directory OUTSIDE the webroot so files are never
# served directly over HTTP (e.g. "/var/lib/lavo/uploads" or ".uploads/station-docs").
# Default (when unset) is ".uploads/station-docs" under the app root.
UPLOAD_LOCAL_PATH=".uploads/station-docs"

# Cron: shared secret for protected GET cron routes, e.g. /api/cron/sync-pending-uploads and /api/cron/send-escrow-weekly-transactions-report. Send header x-cron-secret: <CRON_SECRET> (or Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""

# Firebase FCM (future)
FIREBASE_SERVER_KEY=""
