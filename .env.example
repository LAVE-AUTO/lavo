# Copy to .env and fill in; do not commit .env.

# Database (Neon in dev; Railway PostgreSQL in production)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Seed script (optional; omit to use dev default for seed admin password)
# SEED_ADMIN_PASSWORD=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api/v1"
NODE_ENV="development"

# i18n (next-intl)
# Default locale: fr. Supported: fr, en. URLs: /fr, /en

# Auth (future)
JWT_SECRET="your-jwt-secret-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# OAuth (future)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Stripe (future)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email (Resend, future)
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# Firebase FCM (future)
FIREBASE_SERVER_KEY=""
