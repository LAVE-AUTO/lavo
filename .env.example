# Environment configuration for Hurryline platform
# Copy to .env and fill in; do not commit .env.


#============== Database ==============
#PostgreSQL connection (Neon in dev, Railway in production)

DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"


#============== Seed script ==============
#Optional pre-computed password hash to skip bcrypt at runtime

# SEED_ADMIN_PASSWORD_HASH=""


#============== Application core ==============
#Runtime mode and URL configuration

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api/v1"
# Display name used in emails and UI — change for white-label deployments
NEXT_PUBLIC_APP_NAME="Hurryline"
NODE_ENV="development"


#============== i18n (next-intl) ==============
#Default locale: fr. Supported: fr, en. URLs: /fr, /en


#============== Authentication ==============
#JWT, QR codes, OAuth, NextAuth configuration

JWT_SECRET="your-jwt-secret-generate-with-openssl-rand-base64-32"
# QR token signing secret (HMAC SHA-256): REQUIRED, minimum 32 chars
# Example: openssl rand -base64 48
QR_TOKEN_SECRET=""
# Optional: access-token claim validation (if set, tokens with iss/aud must match)
JWT_ISSUER=""
JWT_AUDIENCE=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Token lifetimes (all have safe production defaults if unset)
# Access token TTL in seconds — default 900 (15 min)
ACCESS_TOKEN_TTL_SECONDS="900"
# Standard session JWT TTL in seconds — default 86400 (1 day)
JWT_DEFAULT_TTL_SECONDS="86400"
# Remember-me JWT TTL in seconds — default 2592000 (30 days)
JWT_REMEMBER_TTL_SECONDS="2592000"
# Email verification link TTL in hours — default 24
EMAIL_VERIFICATION_TTL_HOURS="24"
# Password reset link TTL in minutes — default 60
PASSWORD_RESET_TTL_MINUTES="60"
# Admin OTP TTL in minutes — default 10
OTP_TTL_MINUTES="10"

# Cookie names (change only if you need to avoid conflicts with other apps)
ACCESS_COOKIE_NAME="access_token"
REFRESH_COOKIE_NAME="refresh_token"

# bcrypt cost factor — minimum 12 in production; use 10 in CI to speed up tests
BCRYPT_ROUNDS="12"


#============== OAuth providers ==============
#Google, Facebook (for future integration)

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""


#============== Stripe ==============
#Connect account configuration for payments

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""


#============== Email (Resend) ==============
#Transactional email configuration

RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"


#============== Admin notifications ==============
#Station applications and weekly escrow reports

# Admin notification: recipient for new station application alerts
ADMIN_NOTIFICATION_EMAIL=""
# Weekly escrow report: recipient for /api/cron/send-escrow-weekly-transactions-report
# Falls back to ADMIN_NOTIFICATION_EMAIL if unset
WEEKLY_TRANSACTIONS_REPORT_EMAIL=""
# Weekly escrow report email locale: "fr" or "en" (default: fr)
WEEKLY_REPORT_LOCALE="fr"


#============== Redis (Upstash) ==============
#@upstash/redis REST client - get values from Upstash console → REST API tab
#REDIS_URL is the native TCP URL (for reference / native clients only)

REDIS_URL="rediss://default:<token>@<host>.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://<host>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<token>"


#============== Document uploads ==============
#Cloudinary (primary) with local fallback

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Local fallback path (MUST be outside webroot in production)
# Default: .uploads/station-docs (under app root)
# Production example: /var/lib/Hurryline/uploads
UPLOAD_LOCAL_PATH=".uploads/station-docs"


#============== Cron jobs ==============
#Shared secret for protected cron endpoints

# Secret for: /api/cron/sync-pending-uploads, /api/cron/send-escrow-weekly-transactions-report
# Send header: x-cron-secret: <CRON_SECRET> or Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""


#============== API Documentation ==============
#Set to "true" to enable /api/docs and Swagger UI in production.
#Disabled by default in production to prevent API surface mapping.

ENABLE_API_DOCS=""


#============== Firebase FCM ==============
#Push notifications (for future integration)

FIREBASE_SERVER_KEY=""


#============== Analytics ==============
#Google Analytics 4 and Zoho PageSense (leave empty to disable)

NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_PAGESENSE_ID=""


#============== Rate limiting ==============
#Fallback thresholds when Redis is unavailable or for initial tuning

# Max failed login attempts before account lock — default 5
RATE_LIMIT_MAX_ATTEMPTS="5"
# Lock duration in minutes after max attempts — default 15
RATE_LIMIT_BLOCK_MINUTES="15"
# Max OTP send requests per admin per window — default 3
OTP_RATE_LIMIT_MAX="3"
# OTP rate-limit window in minutes — default 5
OTP_RATE_LIMIT_WINDOW_MINUTES="5"


#============== Platform settings ==============
#Admin-configurable business rules (3-tier fallback: DB → env → hardcoded)

# Default platform commission rate (10%) — overridden by DB setting when set
PLATFORM_COMMISSION_RATE="0.1000"

# Group A: Cancellation policy
PLATFORM_CANCELLATION_FREE_WINDOW_MINUTES="60"
PLATFORM_CANCELLATION_PENALTY_PERCENT="20.00"
PLATFORM_CANCELLATION_PENALTY_PLATFORM_RATE="0.70"
PLATFORM_CANCELLATION_PENALTY_STATION_RATE="0.30"

# Group B: Reservations & booking
PLATFORM_MAX_ADVANCE_BOOKING_DAYS="7"
PLATFORM_RATING_WINDOW_DAYS="7"
PLATFORM_DEFAULT_LATE_TOLERANCE_MINUTES="5"

# Group C: Tips
PLATFORM_MAX_TIP_AMOUNT_XAF="500"

# Group D: Reminders
PLATFORM_REMINDER_FIRST_WINDOW_HOURS="5"
PLATFORM_REMINDER_SECOND_WINDOW_MINUTES="30"

# Group G: KYC document expiry reminders (overrides platform settings if set)
PLATFORM_KYC_REMINDER_FIRST_THRESHOLD_DAYS=30
PLATFORM_KYC_REMINDER_SECOND_THRESHOLD_DAYS=7
# Cron schedule for KYC expiry reminders (default: daily at 8am)
KYC_REMINDER_CRON_SCHEDULE="0 8 * * *"

# Group F: Content limits
PLATFORM_MAX_RATING_COMMENT_LENGTH="500"
PLATFORM_MAX_SUPPORT_MESSAGE_LENGTH="5000"
